# Copie ce fichier en `.env.local` (ignoré par git) et remplis les valeurs.
# Supabase Dashboard > Project Settings > API Keys
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Ces deux valeurs sont publiques par conception (protégées par la RLS).
# Ne mets JAMAIS ici la clé secrète / service_role.

# Nom public du bot Telegram des alertes (sans @), ex. MongetonAlertesBot. Facultatif.
EXPO_PUBLIC_TELEGRAM_BOT=
