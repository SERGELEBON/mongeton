<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Service activé seulement si l'utilisateur l'autorise dans
         Paramètres > Notifications > Accès aux notifications. -->
    <service
      android:name="expo.modules.mongetonnotifications.MongetonNotificationListener"
      android:label="Mongeton"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
